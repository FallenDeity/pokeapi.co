---
import brandLogo from "../../assets/pokeapi_192_square.png";
---

<div class="flex flex-col gap-4">
  <div class="flex items-center gap-2.5">
    <img src={brandLogo.src} alt="PokéAPI" width="40" height="40" class="h-10 w-10 rounded-lg object-contain" />
    <span class="text-[1.25rem] font-bold tracking-tight text-(--sl-color-white)">PokéAPI</span>
  </div>
  <p class="m-0 max-w-75 text-[0.85rem] leading-relaxed text-(--sl-color-gray-2)">
    A free, open and community-driven REST API for Pokémon data, serving <strong
      class="font-bold text-(--sl-color-gray-1)">millions</strong
    > of requests daily.
  </p>
  <div class="flex flex-wrap items-center gap-2.5">
    <a
      href="https://github.com/pokeapi/pokeapi"
      target="_blank"
      rel="noopener"
      class="social-pill github-pill inline-flex items-center gap-1.5 rounded-full border border-transparent px-3 py-1.5 text-[0.8rem] font-medium no-underline transition duration-150 ease-in-out hover:-translate-y-0.5 hover:opacity-90"
      aria-label="GitHub"
    >
      <svg width="16" height="16" viewBox="0 0 98 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
          fill="currentColor"></path>
      </svg>
      GitHub
    </a>
    <a
      href="https://pokeapi.statuspage.io/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center overflow-hidden rounded-md no-underline transition duration-150 ease-in-out hover:-translate-y-0.5 hover:opacity-85"
      aria-label="PokéAPI System Status"
    >
      <img
        src="https://img.shields.io/badge/dynamic/json?style=flat&color=brightgreen&label=status&query=%24.status.description&url=https%3A%2F%2Fzlfyqp3hlvly.statuspage.io%2Fapi%2Fv2%2Fsummary.json"
        alt="PokéAPI System Status"
        class="block h-7 w-auto"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</div>
